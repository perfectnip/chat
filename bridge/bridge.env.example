# Copy this file to bridge.env and fill in real values.
# bridge.env is gitignored — it never leaves your machine.

# jchat server the bridge connects OUT to (no inbound ports needed).
JCHAT_URL=https://jchat.fly.dev

# Auth token the jchat server expects for the helper bridge socket.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JCHAT_HELPER_TOKEN=

# Local OpenClaw gateway (loopback only — the token never leaves this machine).
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_TOKEN=

# Must match OPENCLAW_BRIDGE_SECRET on the jchat server (Fly secrets).
OPENCLAW_BRIDGE_SECRET=

# Optional overrides:
# OPENCLAW_FETCH_TIMEOUT_MS=540000
# OPENCLAW_MODEL=openclaw/default

# OpenCode backend (a second full assistant for the owner's DMs). The bridge
# routes 'opencode' agent mode through a locally-running `opencode serve`
# (https://opencode.ai/docs/server/). Leave unset to disable OpenCode.
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_TIMEOUT_MS=129600000
